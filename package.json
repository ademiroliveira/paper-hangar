{
  "name": "paper-hangar",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @paper-hangar/web",
    "build": "npm run build -w @paper-hangar/web",
    "preview": "npm run preview -w @paper-hangar/web",
    "test": "npm test -w @paper-hangar/crease && npm test -w @paper-hangar/crease-cli",
    "typecheck": "npm run typecheck -w @paper-hangar/crease && npm run typecheck -w @paper-hangar/crease-cli && npm run typecheck -w @paper-hangar/web",
    "previews": "crease previews"
  },
  "engines": { "node": ">=20" }
}
